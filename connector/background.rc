// The version resource of sidevoice-background.exe (build.rs): what Task Manager shows for the program. Numbers are
// spelled out instead of including winver.h, which the resource compiler may not find.
1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "FileDescription", "Sidevoice Background"
      VALUE "ProductName", "Sidevoice Background"
      VALUE "InternalName", "sidevoice-background"
      VALUE "OriginalFilename", "sidevoice-background.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
